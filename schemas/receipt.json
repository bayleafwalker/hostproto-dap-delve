{
  "$defs": {
    "deviation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "suppression"
              }
            }
          },
          "then": {
            "required": [
              "rule_id",
              "raw_ref"
            ]
          }
        }
      ],
      "description": "Something the adapter did not fold into canonical state, or could not. Never dropped silently: counts and categories appear in evidence. A normalization layer that merely throws inconvenient callbacks away has failed.",
      "properties": {
        "data": {
          "type": "object"
        },
        "kind": {
          "enum": [
            "suppression",
            "unmapped_event",
            "divergence",
            "teardown_error",
            "bounded_result"
          ]
        },
        "object_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "raw_ref": {
          "description": "Required for suppression: the raw record that was not folded into canonical state.",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "type": "string"
        },
        "rule_id": {
          "description": "Required for suppression: the normalization rule that suppressed a raw observation.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "kind",
        "reason"
      ],
      "title": "HostProto deviation v1",
      "type": "object"
    },
    "evidence-ref": {
      "additionalProperties": false,
      "description": "Content-addressed. A reference never implies authority to retrieve data outside the evidence bundle it belongs to.",
      "properties": {
        "media_type": {
          "minLength": 1,
          "type": "string"
        },
        "path": {
          "description": "Location inside its evidence bundle only.",
          "type": "string"
        },
        "ref": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "schema_version": {
          "const": "hostproto.evidence-ref/v1"
        },
        "size_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "source_refs": {
          "description": "Raw records a normalized artifact was derived from.",
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "type": "array"
        },
        "surface_class": {
          "enum": [
            "raw",
            "normalized",
            "contract",
            "diagnostic",
            "redacted"
          ]
        }
      },
      "required": [
        "schema_version",
        "ref",
        "surface_class",
        "media_type",
        "size_bytes"
      ],
      "title": "HostProto evidence reference v1",
      "type": "object"
    }
  },
  "$id": "https://hostproto.invalid/schemas/receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "attempted/accepted/executed/verified are independent. A receipt with executed=true and verified=false is legitimate and must be reported as such.",
  "properties": {
    "accepted": {
      "description": "Passed preconditions and target check; host was invoked.",
      "type": "boolean"
    },
    "action_id": {
      "description": "Opaque, server-minted. Never parsed by clients.",
      "minLength": 1,
      "type": "string"
    },
    "attempted": {
      "type": "boolean"
    },
    "caused_events": {
      "description": "Event ids the action caused, from the ordered stream.",
      "items": {
        "description": "Opaque, server-minted. Never parsed by clients.",
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "deviations": {
      "items": {
        "$ref": "#/$defs/deviation"
      },
      "type": "array"
    },
    "effects": {
      "items": {
        "properties": {
          "kind": {
            "type": "string"
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/evidence-ref"
      },
      "type": "array"
    },
    "executed": {
      "description": "Host reported completion.",
      "type": "boolean"
    },
    "outcome": {
      "description": "Exactly one terminal outcome per operation. unknown: the deadline elapsed or the client was interrupted and the effect may have escaped; a deadline never proves an effect did not occur. superseded: a later operation on the same surface overtook this one; it must not silently vanish.",
      "enum": [
        "completed",
        "failed",
        "stopped",
        "superseded",
        "unknown"
      ]
    },
    "provider": {
      "enum": [
        "engine",
        "injected",
        "host",
        "oracle"
      ]
    },
    "receipt_id": {
      "description": "Opaque, server-minted. Never parsed by clients.",
      "minLength": 1,
      "type": "string"
    },
    "revision_after": {
      "minimum": 1,
      "type": "integer"
    },
    "revision_before": {
      "minimum": 1,
      "type": "integer"
    },
    "schema_version": {
      "const": "hostproto.receipt/v1"
    },
    "state_after": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "state_before": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "surface": {
      "description": "Opaque, server-minted. Never parsed by clients.",
      "minLength": 1,
      "type": "string"
    },
    "verified": {
      "description": "An effect or caused event was actually observed. Not merely that the call returned.",
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "receipt_id",
    "action_id",
    "surface",
    "attempted",
    "accepted",
    "executed",
    "verified",
    "outcome",
    "provider",
    "caused_events",
    "effects",
    "revision_before",
    "revision_after"
  ],
  "title": "HostProto receipt v1",
  "type": "object"
}
