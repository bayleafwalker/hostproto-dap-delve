{
  "$defs": {
    "evidence-ref": {
      "additionalProperties": false,
      "description": "Content-addressed. A reference never implies authority to retrieve data outside the evidence bundle it belongs to.",
      "properties": {
        "media_type": {
          "minLength": 1,
          "type": "string"
        },
        "path": {
          "description": "Location inside its evidence bundle only.",
          "type": "string"
        },
        "ref": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "schema_version": {
          "const": "hostproto.evidence-ref/v1"
        },
        "size_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "source_refs": {
          "description": "Raw records a normalized artifact was derived from.",
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "type": "array"
        },
        "surface_class": {
          "enum": [
            "raw",
            "normalized",
            "contract",
            "diagnostic",
            "redacted"
          ]
        }
      },
      "required": [
        "schema_version",
        "ref",
        "surface_class",
        "media_type",
        "size_bytes"
      ],
      "title": "HostProto evidence reference v1",
      "type": "object"
    }
  },
  "$id": "https://hostproto.invalid/schemas/recovery.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval": {
      "const": null,
      "description": "Always null: recovery cannot mint approval. Approval flows through MCP elicitation or A2A INPUT_REQUIRED."
    },
    "cause": {
      "enum": [
        "handle_expired",
        "stale_observation",
        "client_interrupted",
        "writer_fenced",
        "host_terminated",
        "capability_degraded"
      ]
    },
    "checkpoint": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "State reference used for resume. A checkpoint records state; it is never an approval."
    },
    "context": {
      "description": "Opaque, server-minted. Never parsed by clients.",
      "minLength": 1,
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/evidence-ref"
      },
      "type": "array"
    },
    "outcome": {
      "enum": [
        "resumed",
        "reobserve_required",
        "handover_required",
        "human_required",
        "unrecoverable"
      ]
    },
    "schema_version": {
      "const": "hostproto.recovery/v1"
    },
    "writer_epoch": {
      "description": "Epoch after recovery. Increments on handover.",
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "outcome",
    "cause",
    "context",
    "approval"
  ],
  "title": "HostProto recovery v1",
  "type": "object"
}
